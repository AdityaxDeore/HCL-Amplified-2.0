# ============================================================
# LEARNPATH BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=learnpath

# Server & CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173
APP_NAME=LearnPath AI API
DEBUG=True

# ============================================================
# API KEYS
# ============================================================

# YouTube Data API v3 Key (Used in Part 8 for real-time video discovery)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Groq API Key (Optional / Fast LLM Inference)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API Key (Used in Part 9 for Conversational AI Assistant)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
