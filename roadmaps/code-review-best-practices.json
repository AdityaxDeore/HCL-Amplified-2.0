6D6","style":{"fontSize":17},"borderColor":"#4136D6","oldId":"-sFboM4eFUMVq1tlPl-fV"},"zIndex":999,"dragging":false,"positionAbsolute":{"x":11.058722960661697,"y":2679.3089001088356},"style":{"width":120,"height":49},"focusable":true,"resizing":false,"measured":{"width":263,"height":49},"selectable":true},{"width":263,"height":49,"id":"Df3nTlTvSQkMGzpufRo9q","type":"button","position":{"x":-148.92870445796828,"y":3248.2352426534217},"selected":false,"data":{"label":"Engineering Manager","href":"https://roadmap.sh/engineering-manager","color":"#FFFFFf","backgroundColor":"#4136D6","style":{"fontSize":17},"borderColor":"#4136D6","oldId":"-sFboM4eFUMVq1tlPl-fV"},"zIndex":999,"dragging":false,"positionAbsolute":{"x":11.058722960661697,"y":2679.3089001088356},"style":{"width":120,"height":49},"focusable":true,"resizing":false,"measured":{"width":263,"height":49},"selectable":true},{"id":"zIe8oVwRPkMiAelRCGnMX","type":"checklist","position":{"x":-676.9030413578564,"y":77.70256106464302},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Team Wide Practices","style":{"labelAlign":"center"},"checklists":[{"id":"T7MVfQ83t6BE9vmpzaUht","label":"Document and standardize the code review process."},{"id":"ehE5l_WqbJLxsgWdEl0x4","label":"Ensure that the purpose of code reviews is clear to everyone."},{"id":"rVSsMoYYzA-J1WR7Lg4rL","label":"Ensure that \"Definition of Done\" is documented and clear to everyone"},{"id":"LS_8tF9jxSMV9_kINuzUD","label":"Encourage team members to participate in code reviews."},{"id":"CZL7lE5eY6fWdJzoxGeFj","label":"Define a process for conflict resolution in code reviews."},{"id":"AL9JjC7FBmTEL29IEh01n","label":"Have a definitive style guide for style preferences."},{"id":"dGIXxZsVqmjOj1zTxSLJP","label":"Use automation to speed up the code reviews (linting, sniffing etc)"},{"id":"jDlN3ur6BBPu-3ekxr60Z","label":"Set clear expectations for code review turnaround times."},{"id":"c1jaEaau4bwUa9YJY5Dkt","label":"Provide adequate time for code reviews and ensure that it is a priority."},{"id":"0qLP7W7xUjQQW_tfGCKvK","label":"Use code reviews as an opportunity for knowledge sharing and learning."},{"id":"R4VvLERznwaGfobSzE7HH","label":"Encourage reviewing code in unknown-areas for cross-functional knowledge."},{"id":"mVgyN-QcnzKf3NnOH0s9v","label":"Constantly monitor and improve code review process."},{"id":"3tWwh57PzrchYxImA15jr","label":"Recognition and rewards for those with track record of quality feedback."},{"id":"EiBsJq0itHNmEBUWIlN6n","label":"Encourage communication/collaboration; avoid treating code reviews as a one-way process."},{"id":"AzuffOsYr4G0lC7TWCpxT","label":"Hold regular code review sessions to discuss broader trends or issues that arise during the review process."},{"id":"UkTIpoE_E_D-hKUnVVusF","label":"Encourage authors to seek feedback during development before submitting a formal code review.Retry"}],"oldId":"wlrqUL0nTe1q4wE3ejAUe"},"zIndex":999,"measured":{"width":974,"height":613},"dragging":false,"width":974,"height":613,"focusable":true},{"id":"dR2FyZHi8vWnF-yeqLCSW","type":"checklist","position":{"x":-676.9030413578564,"y":694.7025610646431},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Development (Author)","style":{"labelAlign":"center"},"checklists":[{"id":"0iZnwFroy9r4hFLRVO4xr","label":"Follow the coding standards and any other team guidelines."},{"id":"rUj9Rg-OWzLhIz3TeB_8f","label":"Stay consistent with the overall project design and architecture."},{"id":"SUTP4c43Pg2jFCiB_a-oC","label":"Write a failing test if the change is for a bug fix."},{"id":"Xr0gIYZjvRrsYe988ZICH","label":"Break down complex tasks into smaller easily manageable PRs."},{"id":"7CbtJ8k96rgFgVyLZc3KJ","label":"Consider the impact of the change on other parts of the system."},{"id":"1_A2vQO4vYrX6r4hhdgpp","label":"Take notes on any questions or concerns about the change to discuss them during the review."},{"id":"KUSuhknTQleWBdo5IX532","label":"Write the automated tests."},{"id":"PlW1xJD3QlTZvne6D8YDE","label":"Write the documentation for the feature or changes if required."},{"id":"R_GA5FmJQENr36LH08mSm","label":"Update any documentation that may have made obsolete through the changes."}],"oldId":"wlrqUL0nTe1q4wE3ejAUe"},"zIndex":999,"measured":{"width":974,"height":399},"dragging":false,"width":974,"height":399,"resizing":false,"focusable":true},{"id":"IDizJtnubM_XEF4BEdr9Z","type":"checklist","position":{"x":-676.9030413578564,"y":1097.702561064643},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Post Development (Author)","style":{"labelAlign":"center"},"checklists":[{"id":"fjdsrCF8MmSvv5D53yKRC","label":"Review your code before submitting for review."},{"id":"aiMf2dPA8muhDS6l0lrQo","label":"Ensure that the changes are complete and ready for review, including all necessary tests and documentation."},{"id":"m76WiT-GpbZzFb9jXQabt","label":"Verify that the code change has been properly tested in a development environment."},{"id":"qBOld8wsz0uVFKzswghNk","label":"Double-check that the code adheres to the project's coding standards and best practices."},{"id":"XX9R8nAH7WmxjRY5DC9D2","label":"Identify any potential performance, security, or scalability concerns and note them for discussion during the review."},{"id":"HyV5NfOeXxp8A6tPEC6-z","label":"Make sure to add proper title, description, any screenshots, relevant links, configuration changes etc in the PR."},{"id":"GI4xxRUcO4uySlwEVZC78","label":"Approach the review process with an open mind, and be willing to learn from and collaborate with other team members."}],"oldId":"wlrqUL0nTe1q4wE3ejAUe"},"zIndex":999,"measured":{"width":974,"height":325},"dragging":false,"width":974,"height":325,"resizing":false,"focusable":true},{"id":"4J4GzUP0AMCOd4PD_W8KU","type":"checklist","position":{"x":-676.9030413578564,"y":1426.702561064643},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Before Review (Reviewer)","style":{"labelAlign":"center"},"checklists":[{"id":"7qo_yXWXfaqdAix5ICpx8","label":"Understand the requirements and the context in which change was made."},{"id":"TW4WR6k4OxND9vSxSZVhn","label":"Based on the requirements, prepare a list of items that should have been covered in the changes."},{"id":"FfQCEQzNHV8T6A0sJ5OAH","label":"Ensure that you understand the codebase and its architecture."},{"id":"FylLalihY6WSxOL7TshPE","label":"Review any documentation or design specifications related to the change."},{"id":"ykKaoI3dbHH5eQ25qDlxX","label":"Make list of any potential risks or issues that could arise with the change."},{"id":"2rq1Y0vgBNejGx6ZCBAs2","label":"Approach the process with an open mind, be willing to provide constructive feedback and collaborate to improve code quality"},{"id":"z1-pBoaED78ag1EuZa9Aw","label":"Consider the overall quality of the code, including readability, maintainability, and scalability."},{"id":"zfkRUBbiMEX6ArR5T6QVj","label":"Determine the appropriate level of review needed based on the scope and impact of the code change."},{"id":"B4V3lRYoJiMiy5WUDRPAw","label":"Be willing to collaborate with the author to resolve any issues or concerns that arise during the review process.Retry"}],"oldId":"wlrqUL0nTe1q4wE3ejAUe"},"zIndex":999,"measured":{"width":974,"height":389},"dragging":false,"width":974,"height":389,"resizing":false,"focusable":true},{"id":"CUwj117WQa4ulAyViX3sW","type":"checklist","position":{"x":-676.9030413578564,"y":1819.702561064643},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"During Review (Reviewer)","style":{"labelAlign":"center"},"checklists":[{"id":"D46ofUOkbJfOEngyrFtou","label":"Be respectful and professional in your feedback, avoiding personal attacks or derogatory comments."},{"id":"bLhOoyfOgQA12RIIMTKrD","label":"Provide clear and actionable feedback, including specific suggestions for improvement and explanations of any concerns."},{"id":"UluUhUOjICjdzVe8S6abp","label":"Identify any potential performance, security, or scalability concerns, and discuss them with the author."},{"id":"htZEWfHMr6lAe8os4BdC-","label":"Prioritize your feedback, focusing on the most important issues first."},{"id":"_ikL6fwrVtQYinUrCAJW_","label":"Review any tests included with the code change to verify that they adequately cover the functionality and edge cases."},{"id":"3Mh3By6sRGyxoAkrNn0rX","label":"Ensure that the code change adheres to the project's coding standards and best practices."},{"id":"cz4OLM06-yszCBrdYjYX1","label":"Ensure that the relevant documentation has been updated."},{"id":"S4y-DPpW4_jNkAkajiR0b","label":"Team wide styleguide is the absolute authority styling. Verify changes against those instead of personal preferences"},{"id":"L4O2FnOwkQdZQnasKea3U","label":"Leave comments to suggest improvements, but prefix it with \"Nit\" if it's not critical to meeting the standards"},{"id":"UuGrZZKtMAglBtkjz4ghy","label":"Seek continuous improvement, not perfection."},{"id":"re_QIKOxzNrdjEbFbHA08","label":"Keep the short-term and long-term considerations in mind."},{"id":"U7bXFRcG-0_wBSYJjmpKe","label":"Consider using pair programming as an alternative or supplement to code reviews."},{"id":"B4MNj1KETlm_3DLvCOdn6","label":"Provide positive feedback in addition to constructive criticism, to reinforce good practices and boost team morale."}],"oldId":"wlrqUL0nTe1q4wE3ejAUe"},"zIndex":999,"measured":{"width":974,"height":517},"dragging":false,"width":974,"height":517,"resizing":false,"focusable":true},{"id":"o1W6YQx36_CWpvAmgLzam","type":"checklist","position":{"x":-676.9030413578564,"y":2340.7025610646433},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"After Review (Author)","style":{"labelAlign":"center"},"checklists":[{"id":"3C7qvM9nnaog9QrwiJq98","label":"Address all the feedback received, including any concerns or questions raised."},{"id":"NdJBdFOnyuFdpWdQyyA4u","label":"Impleme