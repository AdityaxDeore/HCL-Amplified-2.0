ntSize":20},"href":"","color":"#000000","oldId":"wvox8P3JLVUAsmLnFArC4"},"zIndex":999,"measured":{"width":255,"height":42},"dragging":false,"focusable":true},{"id":"X5rFjJHpijmZaTJY9PH6x","type":"paragraph","position":{"x":-107.92197677120538,"y":2120.6657284387957},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Most AI tools' default behavior produces implementation-first code with minimal test coverage. Whenever AI builds a feature, force it to write basic tests right away to ensure that bugs get caught early.","style":{"fontSize":17,"borderColor":"#ffffff","backgroundColor":"#ffffff","color":"#000000","textAlign":"left","justifyContent":"center","padding":16},"oldId":"J5tFxtigM1kgigpkwxgzq"},"zIndex":999,"measured":{"width":472,"height":153},"dragging":false,"width":472,"height":153,"resizing":false,"focusable":true},{"id":"7PD3hS-8933MPlkrFP-OU","type":"label","position":{"x":-110.25049426545795,"y":755.3776496355504},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Never Hardcode your Secrets","style":{"fontSize":20},"href":"","color":"#000000","oldId":"2gTgoEBdxzT2Shkqcpvi8"},"zIndex":999,"measured":{"width":283,"height":42},"dragging":false,"focusable":true},{"id":"O7IdWdTSlyP2BtMWAxnZ1","type":"paragraph","position":{"x":-110.25049426545795,"y":797.3776496355504},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Never let the AI put passwords, API keys, or tokens directly in the code. If you see it doing this, stop it and ask it to use environment variables instead. ","style":{"fontSize":17,"borderColor":"#ffffff","backgroundColor":"#ffffff","color":"#000000","textAlign":"left","justifyContent":"center","padding":16},"oldId":"X5rFjJHpijmZaTJY9PH6x"},"zIndex":999,"measured":{"width":472,"height":141},"dragging":false,"width":472,"height":141,"resizing":false,"focusable":true},{"id":"O9W3d1q1yJmfRJHnfognN","type":"todo","position":{"x":-749.6801562444155,"y":500.5831801961953},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Implement Spec-Driven Development (SDD)","style":{"fontSize":17},"oldId":"ODqMzOAN1je004chwATTl"},"zIndex":999,"measured":{"width":386,"height":41},"dragging":false,"resizing":false,"focusable":true},{"id":"eMMFaVwsxY2tVE9uWz5qT","type":"subtopic","position":{"x":-323.6562421081181,"y":48.17498071115827},"selected":false,"selectable":true,"draggable":true,"deletable":true,"data":{"label":"Codex","style":{"fontSize":17,"justifyContent":"flex-start","textAlign":"center"}},"zIndex":999,"measured":{"width":150,"height":49},"width":150,"height":49,"dragging":false,"focusable":true}],"edges":[{"style":{"strokeDasharray":"0","strokeLinecap":"round","strokeWidth":3.5,"stroke":"#2b78e4"},"source":"hJTqFZ1Ot21tzcUzmnOxo","sourceHandle":"x2","target":"lzHnwx_3gftRZbstk6INB","targetHandle":"w1","data":{"edgeStyle":"solid"},"id":"xy-edge__hJTqFZ1Ot21tzcUzmnOxox2-lzHnwx_3gftRZbstk6INBw1","selected":false,"selectable":true,"focusable":true},{"style":{"strokeDasharray":"0","strokeLinecap":"round","strokeWidth":3.5,"stroke":"#2b78e4"},"source":"LkLQ8GjBXDuw1XsrE4Cjj","sourceHandle":"x2","target":"pfgsxuQ-D7dTMPNWKG9OY","targetHandle":"w1","data":{"edgeStyle":"solid"},"id":"xy-edge__LkLQ8GjBXDuw1XsrE4Cjjx2-DjbYhSENk8A7tVyBiFYhQw1","selected":false,"focusable":true,"selectable":true}],"draft":null,"seo":{"title":"Vibe Coding","description":"Learn vibe coding from scratch. Tips, tricks, and best practices for getting the most out of AI-assisted coding tools like Claude Code, Cursor, and more.","keywords":[],"_id":"6a1dc478ac1c5fa9928a980f"},"type":"skill","dimensions":{"height":2753,"width":1158},"relatedRoadmaps":["claude-code","ai-agents","ai-engineer","prompt-engineering"],"courses":[],"aiCourses":["Claude Code Crash Course","Cursor Crash Course","Gemini Crash Course","Mastering Prompt Engineering","Mastering Context Engineering","Secure Vibe Coding","Mastering CLAUDE.md","Mastering Vibe Debugging","Mastering Vibe Testing","Mastering Vive Refactoring"],"questions":[{"type":"faq","title":"What are the best vibe coding tools?","description":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Choosing the best vibe coding tool depends on your needs, expertise, and use case. A tool built for a senior engineer working on complex projects might not be the best fit for a student working on their first project, and vice versa. There’s an increasing number of vibe coding tools out there, ranging from AI app builders, like Lovable, Bolt, and Replit to AI coding assistants, such as Claude Code and Codex. Check our dedicated guide to know the best "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://roadmap.sh/vibe-coding/best-tools","target":"_blank","rel":"noopener noreferrer nofollow","class":"tiptap-link"}}],"text":"vibe coding tools."}]},{"type":"paragraph"}]},"_id":"69de39a631e228f31bc91209","createdAt":"2026-04-14T12:57:10.489Z","updatedAt":"2026-04-14T12:57:10.489Z"},{"type":"faq","title":"What exactly is vibe coding?","description":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"\"Vibe coding\" is a software development methodology in which you use AI and LLMs to generate code via natural-language prompts rather than writing it by hand. The idea is you describe what you want the application to do, and AI builds it. Good for fast prototyping. You don't need to review every line of code. Makes development faster and more accessible for people who are not traditional programmers."}]}]},"_id":"69de39d831e228f31bc91211","createdAt":"2026-04-14T12:58:00.456Z","updatedAt":"2026-04-14T12:58:00.456Z"},{"type":"faq","title":"How can I begin vibe coding?","description":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Getting hands-on practice with vibe coding tools is the best way to get familiar with them. Choose a popular tool with a free plan and start creating a small application. After several prompts, you will start to know its capabilities and limitations. If you want to get an idea of what it means to vibe code, check out our "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://roadmap.sh/vibe-coding/tutorial","target":"_blank","rel":"noopener noreferrer nofollow","class":"tiptap-link"}}],"text":"Vibe coding tutorial"},{"type":"text","text":" with Claude Code."}]}]},"_id":"69de3afc31e228f31bc9121a","createdAt":"2026-04-20T15:15:17.989Z","updatedAt":"2026-04-20T15:15:17.989Z"},{"type":"faq","title":"How can I get good results from vibe coding?","description":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Getting good results from vibe coding is a matter of discipline and knowing the capabilities and weaknesses of the vibe coding tool you’re using. If you don’t want to run out of tokens after a couple of prompts or get apps that look nice but are full of bugs, you must stick to good practices. In particular, you should focus on detailed upfront planning, modular, small-step implementation, and rigorous version control. For a detailed catalogue, check out our "},{"type":"text","marks":[{"type":"link","attrs":{"href":"https://roadmap.sh/vibe-coding/best-practices","target":"_blank","rel":"noopener noreferrer nofollow","class":"tiptap-link"}}],"text":"Vibe Coding Best Practices"},{"type":"text","text":" guide."}]}]},"_id":"69e644d931e228f31bc926dc","createdAt":"2026-04-20T15:23:05.989Z","updatedAt":"2026-04-20T15:23:05.989Z"}],"createdAt":"2026-02-17T10:56:16.520Z","updatedAt":"2026-08-06T15:08:49.057Z"}